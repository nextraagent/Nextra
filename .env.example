# Copy to .env.local for local development. Never commit real values.

# --- Privy (login, embedded wallets, Sentry signer) ---
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_SIGNER_ID=
PRIVY_APP_SECRET=
# Authorization private key from Privy dashboard (starts with "wallet-auth:")
PRIVY_AUTHORIZATION_KEY=
# Optional: PEM verification key instead of fetching Privy's JWKS
PRIVY_VERIFICATION_KEY=

# --- Storage (Upstash Redis REST) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Sentry ---
# Optional: require ?key=<value> on /api/sentry/tick
SENTRY_TICK_KEY=
# Optional: slippage in basis points (default 150 = 1.5%)
SENTRY_SLIPPAGE_BPS=
# Optional: route swaps through USDG as well as direct WETH pools
USDG_ADDRESS=
# Optional: custom Robinhood Chain RPC
RPC_URL=

# --- Vault & daily drops (after launch) ---
CRON_SECRET=
DROPS_ENABLED=false
NEXTRA_TOKEN=
VAULT_ADDRESS=
VAULT_PRIVATE_KEY=
# Comma-separated wallets excluded from drops (dev wallet, pools, ...)
EXCLUDE_WALLETS=
# JSON map of stock symbol -> token address, e.g. {"NVDA":"0x..."}
STOCK_TOKENS=
DEFAULT_STOCK=
